

<script type="application/ld+json">
  {{ closest.product | structured_data }}
</script>

{% capture media_gallery %}
  {%- content_for 'block',
    type: '_product-media-gallery',
    id: 'media-gallery',
    closest.product: closest.product
  -%}
{% endcapture %}

{% capture product_details %}
  {% content_for 'block',
    type: '_product-details',
    id: 'product-details',
    closest.product: closest.product
  %}
{% endcapture %}

{% capture additional_blocks %}
  {% content_for 'blocks' %}
{% endcapture %}

{% capture pdp_breadcrumbs %}
  {% if section.settings.show_breadcrumbs and closest.product != blank %}
    {% liquid
      assign breadcrumb_collection = collection
      if breadcrumb_collection == blank
        assign breadcrumb_collection = closest.product.collections.first
      endif
    %}
    <nav class="shopco-pdp__breadcrumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
      {% if breadcrumb_collection != blank and breadcrumb_collection.handle != 'all' %}
        <span aria-hidden="true">/</span>
        <a href="{{ breadcrumb_collection.url }}">{{ breadcrumb_collection.title | escape }}</a>
      {% endif %}
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ closest.product.title | escape }}</span>
    </nav>
  {% endif %}
{% endcapture %}

{% if section.settings.enable_sticky_add_to_cart %}
  {% liquid
    assign current_variant = product.selected_or_first_available_variant
    # Get the initial quantity based on quantity rules
    assign initial_quantity = current_variant.quantity_rule.min | default: 1
  %}

  <sticky-add-to-cart
    class="sticky-add-to-cart"
    data-variant-available="{{ current_variant.available }}"
    data-product-id="{{ product.id }}"
    data-current-variant-id="{{ current_variant.id }}"
    data-initial-quantity="{{ initial_quantity }}"
    data-default-variant-title="{{ 'products.product.default_title' | t }}"
  >
    <div
      class="sticky-add-to-cart__bar color-{{ settings.popover_color_scheme }}"
      data-stuck="false"
      ref="stickyBar"
      role="region"
      aria-label="{{ 'products.product.sticky_add_to_cart' | t }}"
    >
      {% liquid
        assign image_to_show = current_variant.featured_image | default: product.featured_image
      %}
      {% if image_to_show %}
        <div
          class="sticky-add-to-cart__image"
        >
          {% assign image_alt = image_to_show.alt | default: product.title | escape %}
          {{
            image_to_show
            | image_url: width: 120
            | image_tag:
              loading: 'lazy',
              alt: image_alt,
              class: 'sticky-add-to-cart__image-img',
              data-testid: 'sticky-product-image',
              srcset: null,
              sizes: null,
              ref: 'productImage'
          }}
        </div>
      {% endif %}

      {% liquid
        assign has_single_option = false
        if product.has_only_default_variant != true and product.options.size == 1
          assign has_single_option = true
        endif

        if image_to_show == blank
          assign has_image = false
        else
          assign has_image = true
        endif
      %}
      <div
        class="sticky-add-to-cart__info"
        data-has-image="{{ has_image }}"
        data-singleton="{{ product.has_only_default_variant }}"
        data-single-option="{{ has_single_option }}"
      >
        <p
          class="sticky-add-to-cart__title"
          data-testid="sticky-product-title"
        >
          {{ product.title | escape }}
        </p>
        <div
          class="sticky-add-to-cart__variant"
          data-testid="sticky-variant-title"
          {% if product.has_only_default_variant %}
            style="display: none;"
          {% endif %}
        >
          {% unless product.has_only_default_variant %}
            {% if current_variant != blank %}
              {% assign variant_title = current_variant.title | escape %}
            {% endif %}
            {{ variant_title }}
          {% endunless %}
        </div>
      </div>

      <div
        class="sticky-add-to-cart__price"
        data-testid="sticky-price-display"
      >
        {% render 'price', product_resource: product, show_sale_price_first: true %}
      </div>

      <button
        type="button"
        class="sticky-add-to-cart__button add-to-cart-button button"
        ref="addToCartButton"
        on:click="/handleAddToCartClick"
        {% unless current_variant.available %}
          disabled
        {% endunless %}
      >
        <span
          class="add-to-cart-text"
        >
          {% if current_variant.available %}
            <span class="svg-wrapper add-to-cart-icon">
              {{- 'icon-add-to-cart.svg' | inline_asset_content -}}
            </span>
          {% endif %}
          <span class="add-to-cart-text__content">
            <span>
              {%- if current_variant.available -%}
                {{- 'products.product.add_to_cart' | t -}}
              {%- elsif current_variant == blank -%}
                {{- 'products.product.unavailable' | t -}}
              {%- else -%}
                {{- 'products.product.sold_out' | t -}}
              {%- endif -%}
            </span>
            <span
              ref="quantityDisplay"
              {% if current_variant.available and initial_quantity > 1 %}
                style="display: inline;"
              {% else %}
                style="display: none;"
              {% endif %}
            >
              {{- ' (' -}}
              <span ref="quantityNumber">{{- initial_quantity -}}</span>
              {{- ')' -}}
            </span>
          </span>
        </span>
        <span class="add-to-cart__added">
          <span class="svg-wrapper add-to-cart__added-icon">
            {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
          </span>
        </span>
      </button>
    </div>
  </sticky-add-to-cart>
{% endif %}

<div
  class="shopco-pdp"
  style="--shopco-gallery-background: {{ section.settings.gallery_background }}; --shopco-gallery-radius: {{ section.settings.gallery_border_radius }}px;"
>
  {% render 'product-information-content',
    product_media_size: closest.product.media.size,
    section_id: section.id,
    settings: section.settings,
    media_gallery: media_gallery,
    product_details: product_details,
    additional_blocks: additional_blocks,
    breadcrumbs: pdp_breadcrumbs
  %}
</div>

{% stylesheet %}
  .shopco-pdp__breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.1);
    padding-block-start: 14px;
    margin-block-end: 8px;
    color: rgb(var(--color-foreground-rgb) / 0.55);
    font-size: var(--font-size--sm);
    line-height: 1.4;
  }

  .shopco-pdp__breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .shopco-pdp__breadcrumbs a:hover {
    color: var(--color-foreground);
  }

  .shopco-pdp__breadcrumbs [aria-current='page'] {
    color: rgb(var(--color-foreground-rgb) / 0.8);
  }

  .shopco-pdp .product-information__media {
    width: 100%;
    min-width: 0;
  }

  .shopco-pdp .product-information__media .product-media-container:not(.dialog-zoomed-gallery *) {
    background: var(--shopco-gallery-background);
    border-radius: var(--shopco-gallery-radius);
  }

  .shopco-pdp
    .product-information__media
    .media-gallery--carousel
    slideshow-slide.product-media-container--image
    .product-media {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(12px, 2vw, 18px);
  }

  .shopco-pdp .product-information__media .product-media-container:not(.dialog-zoomed-gallery *) :is(img, video) {
    object-fit: contain;
    background: transparent;
  }

  .shopco-pdp .product-information__media media-gallery {
    --slideshow-thumbnails-padding-inline: 0;
    --slideshow-thumbnails-padding-block: 0;
    --shopco-thumb-gap: 14px;
    --shopco-thumbnail-size: clamp(82px, 23vw, 94px);
    --shopco-thumb-column-height: calc(var(--shopco-thumbnail-size) * 3 + var(--shopco-thumb-gap) * 2);
    --shopco-gallery-max-height: min(56vw, 400px);
  }

  .shopco-pdp .product-information__media .media-gallery--carousel slideshow-container {
    overflow: hidden;
    inline-size: 100%;
    max-inline-size: 100%;
    min-inline-size: 0;
  }

  .shopco-pdp
    .product-information__media
    .media-gallery--carousel
    slideshow-component.slideshow--single-media {
    inline-size: min(100%, var(--shopco-gallery-max-height));
    min-inline-size: min(100%, var(--shopco-gallery-max-height));
    width: min(100%, var(--shopco-gallery-max-height));
  }

  .shopco-pdp
    .product-information__media
    .slideshow--single-media
    slideshow-slide {
    content-visibility: visible;
    min-block-size: var(--shopco-gallery-max-height);
  }

  .shopco-pdp
    .product-information__media
    .slideshow--single-media
    slideshow-slide[aria-hidden='false']
    .product-media-container {
    min-block-size: var(--shopco-gallery-max-height);
  }

  .shopco-pdp .product-information__media .media-gallery--carousel slideshow-slides {
    --slideshow-gap: 0;
    gap: 0;
    scroll-snap-type: x mandatory;
  }

  .shopco-pdp
    .product-information__media
    .media-gallery--carousel
    slideshow-slide.product-media-container {
    flex: 0 0 100%;
    inline-size: 100%;
    width: 100%;
    max-inline-size: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .shopco-pdp
    .product-information__media
    .product-media-container.constrain-height:not(.dialog-zoomed-gallery *) {
    inline-size: 100%;
    width: 100%;
    max-inline-size: 100%;
    margin-inline: 0;
  }

  .shopco-pdp
    .product-information__media
    .media-gallery--hint
    :not(.dialog-zoomed-gallery)
    > .product-media-container:not(:only-child) {
    width: 100%;
  }

  .shopco-pdp .product-information__media .slideshow-controls__thumbnails {
    gap: var(--shopco-thumb-gap);
    margin-inline: 0;
  }

  .shopco-pdp
    .product-information__media
    slideshow-controls:not([controls-on-media])
    .slideshow-controls__thumbnails {
    padding-block: 0;
  }

  .shopco-pdp .product-information__media .slideshow-controls__thumbnail {
    flex: 0 0 var(--shopco-thumbnail-size);
    inline-size: var(--shopco-thumbnail-size);
    block-size: var(--shopco-thumbnail-size);
    width: var(--shopco-thumbnail-size);
    height: var(--shopco-thumbnail-size);
    aspect-ratio: 1;
    box-sizing: border-box;
    background: var(--shopco-gallery-background);
    border: 2px solid transparent;
    border-radius: var(--thumbnail-radius, 12px);
    overflow: hidden;
    outline: none;
    box-shadow: none;
  }

  .shopco-pdp .product-information__media .slideshow-controls__thumbnail img {
    box-sizing: border-box;
    object-fit: contain;
    background: transparent;
    padding: 6px;
  }

  .shopco-pdp
    .product-information__media
    .slideshow-controls__thumbnails
    .slideshow-controls__thumbnail[aria-selected='true'] {
    border: 2px solid #000;
    outline: none;
    box-shadow: none;
  }

  .shopco-pdp .product-information__media .slideshow-controls__thumbnail:focus-visible {
    outline: var(--focus-outline-width) solid var(--color-foreground);
    outline-offset: var(--focus-outline-offset);
  }

  .shopco-pdp .product-details > .group-block {
    width: 100%;
  }

  .shopco-pdp .product-details > .group-block > .group-block-content {
    gap: 0;
  }

  .shopco-pdp .product-details h1 {
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 3.25vw, 2.65rem);
    font-weight: var(--font-heading--weight);
    letter-spacing: -0.04em;
    line-height: 1.08;
    text-transform: uppercase;
    margin: 0 0 12px;
  }

  .shopco-pdp .product-details .rating-wrapper {
    --star-fill-color: #ffc633;
    --star-fill-color-rgb: 255 198 51;

    margin-block-end: 14px;
    color: var(--color-foreground);
  }

  .shopco-pdp .product-details .rating-wrapper .rating-count,
  .shopco-pdp .product-details .rating-wrapper .rating-value {
    color: rgb(var(--color-foreground-rgb) / 0.72);
    font-size: var(--font-size--sm);
  }

  .shopco-pdp .product-details product-price {
    font-size: clamp(1.65rem, 2.6vw, 2rem);
    font-weight: 700;
    line-height: 1.2;
    margin-block-end: 16px;
  }

  .shopco-pdp .product-details product-price > div,
  .shopco-pdp .product-details .price__sale:not(.price__hidden) {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .shopco-pdp .product-details .compare-at-price {
    color: rgb(var(--color-foreground-rgb) / 0.38);
    opacity: 1;
  }

  .shopco-pdp .shopco-price__badge {
    display: inline-flex;
    align-items: center;
    padding: 5px 13px;
    border-radius: 999px;
    background: #ffebeb;
    color: #ff3333;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .shopco-pdp .product-details .product-description__text {
    color: rgb(var(--color-foreground-rgb) / 0.6);
    font-size: 0.95rem;
    line-height: 1.55;
    max-height: 4.65em;
    overflow: hidden;
    margin-block-end: 20px;
  }

  .shopco-pdp .product-details .product-description__text :is(p, ul, ol) {
    margin-block: 0;
  }

  .shopco-pdp .product-details .divider {
    margin-block-end: 20px;
  }

  .shopco-pdp .product-details .divider__line {
    border-color: rgb(var(--color-foreground-rgb) / 0.12);
  }

  .shopco-pdp .variant-picker {
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    margin-block-end: 20px;
    padding-block-end: 20px;
  }

  .shopco-pdp .variant-option--buttons {
    gap: 12px;
  }

  .shopco-pdp .variant-option--buttons legend {
    flex-basis: 100%;
    color: rgb(var(--color-foreground-rgb) / 0.6);
    font-size: var(--font-size--sm);
    margin-block-end: 12px;
  }

  .shopco-pdp .variant-option + .variant-option {
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
    margin-block-start: 20px;
    padding-block-start: 20px;
  }

  .shopco-pdp .variant-option--swatches {
    --variant-picker-swatch-width: 31px;
    --variant-picker-swatch-height: 31px;
    --variant-picker-swatch-radius: 50%;
  }

  .shopco-pdp .variant-option--swatches .variant-option__button-label--has-swatch:has(:checked) {
    outline-width: 2px;
  }

  .shopco-pdp .variant-option--buttons:not(.variant-option--swatches) .variant-option__button-label {
    --options-border-width: 0px;

    border-radius: 999px;
    border: 0;
    min-height: 42px;
    padding-inline: 22px;
    background: #f0f0f0;
    color: rgb(var(--color-foreground-rgb) / 0.62);
  }

  .shopco-pdp .variant-option--buttons:not(.variant-option--swatches) .variant-option__button-label__pill {
    background: #000;
  }

  .shopco-pdp .variant-option--buttons:not(.variant-option--swatches) .variant-option__button-label:has(:checked) {
    color: #fff;
  }

  .shopco-pdp .variant-option__button-label:has([data-option-available='false']) {
    opacity: 0.48;
  }

  .shopco-pdp .product-form-buttons {
    flex-wrap: wrap;
    gap: 14px;
  }

  .shopco-pdp .quantity-selector {
    --quantity-selector-width: 122px;

    border: 0;
    border-radius: 999px;
    background: #f0f0f0;
    min-height: var(--height-buy-buttons);
  }

  .shopco-pdp .product-form-buttons .add-to-cart-button {
    border-radius: 999px;
    background: #000;
    color: #fff;
  }

  .shopco-pdp .product-form-buttons .add-to-cart-icon {
    display: none;
  }

  .shopco-pdp .accelerated-checkout-block {
    flex: 1 1 100%;
    min-width: 100%;
  }

  @media screen and (min-width: 750px) {
    .shopco-pdp .product-information__media media-gallery {
      --shopco-thumbnail-size: 126px;
      --shopco-thumb-gap: 14px;
      --shopco-thumb-column-height: calc(var(--shopco-thumbnail-size) * 3 + var(--shopco-thumb-gap) * 2);
      --shopco-gallery-max-height: calc(var(--shopco-thumb-column-height) - 28px);
    }

    .shopco-pdp .product-information__media .media-gallery--carousel slideshow-container {
      inline-size: min(100%, var(--shopco-gallery-max-height));
    }

    .shopco-pdp
      .product-information__media
      .product-media-container.constrain-height:not(.dialog-zoomed-gallery *) {
      --constrained-min-height: 280px;
      --viewport-offset: 400px;
      max-height: var(--shopco-gallery-max-height);
    }

    .shopco-pdp
      .product-information__media
      .media-gallery--carousel
      slideshow-slide.product-media-container--image
      .product-media {
      padding: clamp(8px, 1.2vw, 12px);
    }

    .shopco-pdp
      .product-information__media
      .media-gallery--carousel
      slideshow-component:is(:has(slideshow-controls[thumbnails]), .slideshow--single-media) {
      align-items: start;
      column-gap: var(--shopco-thumb-gap);
    }

    .shopco-pdp .product-information__media slideshow-controls[thumbnails][pagination-position='left'] {
      align-self: start;
      block-size: auto;
      height: auto;
      inline-size: var(--shopco-thumbnail-size);
      min-block-size: 0;
      min-height: 0;
    }

    .shopco-pdp
      .product-information__media
      slideshow-controls[thumbnails][pagination-position='left']
      .slideshow-controls__thumbnails-container {
      block-size: auto;
      height: auto;
    }

    .shopco-pdp
      .product-information__media
      slideshow-controls[thumbnails][pagination-position='left']
      .slideshow-controls__thumbnails {
      block-size: var(--shopco-thumb-column-height);
      min-block-size: var(--shopco-thumb-column-height);
    }

    .shopco-pdp .product-information__media .slideshow-controls__thumbnail img {
      padding: 8px;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .shopco-pdp .product-information__grid:not(.product-information--media-none) {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .shopco-pdp .product-information__media,
    .shopco-pdp .product-details {
      padding-inline: 0 !important;
      width: 100%;
    }
  }

  @media screen and (min-width: 990px) {
    .shopco-pdp .product-information__grid:not(.product-information--media-none).product-information--media-left {
      grid-template-columns: minmax(0, max-content) minmax(380px, 1fr);
      gap: clamp(18px, 2vw, 28px);
      justify-content: start;
    }

    .shopco-pdp .product-information--media-left .product-information__media {
      --shopco-thumbnail-size: 126px;
      --shopco-thumb-gap: 14px;
      --shopco-thumb-column-height: calc(var(--shopco-thumbnail-size) * 3 + var(--shopco-thumb-gap) * 2);
      --shopco-gallery-max-height: calc(var(--shopco-thumb-column-height) - 28px);
      --shopco-gallery-width: calc(
        var(--shopco-thumbnail-size) + var(--shopco-thumb-gap) + var(--shopco-gallery-max-height)
      );

      justify-self: end;
      width: auto;
      min-width: min(100%, var(--shopco-gallery-width));
      max-width: 100%;
      padding-inline: 0;
    }

    .shopco-pdp
      .product-information--media-left
      .product-information__media
      .media-gallery--carousel
      slideshow-component:has(slideshow-controls[thumbnails]) {
      inline-size: var(--shopco-gallery-width);
      max-inline-size: 100%;
      min-inline-size: var(--shopco-gallery-width);
    }

    .shopco-pdp
      .product-information--media-left
      .product-information__media
      .media-gallery--carousel
      slideshow-component.slideshow--single-media:not(:has(slideshow-controls[thumbnails])) {
      inline-size: min(100%, var(--shopco-gallery-max-height));
      max-inline-size: 100%;
      min-inline-size: min(100%, var(--shopco-gallery-max-height));
      width: min(100%, var(--shopco-gallery-max-height));
    }

    .shopco-pdp .product-information--media-left .product-details {
      justify-self: start;
      padding-inline: 0;
    }
  }

  @media screen and (min-width: 1200px) {
    .shopco-pdp .product-information__grid:not(.product-information--media-none).product-information--media-left {
      grid-template-columns: minmax(0, max-content) minmax(400px, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .shopco-pdp__breadcrumbs {
      padding-block-start: 12px;
      margin-block-end: 6px;
      gap: 8px;
    }

    .shopco-pdp .product-information__media {
      margin-block-end: 24px;
    }

    .shopco-pdp .product-information__media media-gallery {
      --shopco-thumb-gap: 14px;
      --shopco-thumbnail-size: clamp(84px, 24vw, 96px);
      --shopco-thumb-column-height: calc(var(--shopco-thumbnail-size) * 3 + var(--shopco-thumb-gap) * 2);
      --shopco-gallery-max-height: min(54vw, 380px);
    }

    .shopco-pdp
      .product-information__media
      .product-media-container.constrain-height:not(.dialog-zoomed-gallery *) {
      max-height: var(--shopco-gallery-max-height);
    }

    .shopco-pdp
      .product-information__media
      .media-gallery--carousel
      slideshow-slide.product-media-container--image
      .product-media {
      padding: 8px;
    }

    .shopco-pdp .product-information__media slideshow-controls[thumbnails] {
      justify-content: flex-start;
      min-height: 0;
      margin-block-start: 16px;
      overflow: hidden;
    }

    .shopco-pdp .product-information__media .slideshow-controls__thumbnails-container {
      overflow-x: auto;
      padding: 2px 0;
      scrollbar-width: none;
    }

    .shopco-pdp .product-information__media .slideshow-controls__thumbnails {
      flex-direction: row;
      gap: var(--shopco-thumb-gap);
      margin-inline: 0;
      padding: 0;
    }

    .shopco-pdp .product-information__media .slideshow-controls__thumbnail img {
      padding: 7px;
    }

    .shopco-pdp
      .product-information__media
      .media-gallery__mobile-controls
      .slideshow-controls__thumbnail {
      flex: 0 0 var(--shopco-thumbnail-size);
      width: var(--shopco-thumbnail-size);
      height: var(--shopco-thumbnail-size);
    }

    .shopco-pdp .product-details h1 {
      font-size: clamp(1.75rem, 9vw, 2.1rem);
    }

    .shopco-pdp .product-details product-price {
      font-size: 1.55rem;
    }
  }

  @media screen and (max-width: 420px) {
    .shopco-pdp .product-form-buttons {
      flex-wrap: wrap;
    }

    .shopco-pdp .quantity-selector-wrapper,
    .shopco-pdp .quantity-selector {
      width: 100%;
    }
  }

  .sticky-add-to-cart__bar {
    position: fixed;
    bottom: 20px;
    left: 50%;
    opacity: 0;
    transform: translateX(-50%) translateY(calc(100% + 40px));
    z-index: calc(var(--layer-sticky) - 1); /* Below sticky header */
    display: block;
    width: 600px;
    border-radius: calc(
      var(--style-border-radius-buttons-primary) + min(var(--padding-sm), var(--style-border-radius-buttons-primary))
    );
    box-shadow: var(--shadow-popover);
    padding: var(--padding-sm);
    /* Layout styling */
    display: flex;
    align-items: center;
    gap: var(--gap-md);

    @starting-style {
      opacity: 0;
      transform: translateX(-50%) translateY(calc(100% + 40px));
    }

    &::before {
      --border: 2px;
      content: '';
      position: absolute;
      inset: calc(var(--border) * -1);
      background: linear-gradient(var(--color-background) 0 100%), linear-gradient(hsl(0 0% 0% / 0.15) 0 100%);
      background-clip: content-box, border-box;
      border: var(--border) solid #0000;
      border-radius: inherit;
      z-index: -1;
      backdrop-filter: blur(20px) saturate(180%) brightness(1.5);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .sticky-add-to-cart__bar {
      transition-property: transform, opacity, display;
      transition-duration: 0.3s;
      transition-timing-function: var(--ease-out-quad);
      transition-behavior: allow-discrete;
    }
  }

  .sticky-add-to-cart__bar[data-stuck='true'] {
    transform: translateX(-50%) translateY(0%);
    opacity: 1;
  }

  sticky-add-to-cart:not([data-variant-available='true']) .sticky-add-to-cart__bar {
    opacity: 0;
    transform: translateX(-50%) translateY(calc(100% + 40px));
    display: none;
  }

  .sticky-add-to-cart__info[data-has-image='false'] {
    padding-left: var(--padding-lg);
  }

  .sticky-add-to-cart__image {
    flex-shrink: 0;
    aspect-ratio: 1;
    height: var(--height-buy-buttons);
    overflow: hidden;
    border-radius: var(--style-border-radius-buttons-primary);
    background: var(--color-background-secondary);
  }

  .sticky-add-to-cart__image-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sticky-add-to-cart__info {
    flex: 1;
    min-width: 0; /* Allow text truncation */
  }

  .sticky-add-to-cart__title {
    font-size: var(--font-paragraph-medium--size);
    font-weight: var(--font-weight-semibold);
    line-height: var(--font-paragraph--line-height);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sticky-add-to-cart__variant {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    font-size: var(--font-paragraph-small--size);
    margin-top: var(--margin-3xs);
  }

  .sticky-add-to-cart__price {
    font-weight: var(--font-weight-semibold);
  }

  .sticky-add-to-cart__button {
    height: var(--height-buy-buttons);
    position: relative;
  }

  /* Mobile adjustments */
  @media screen and (max-width: 749px) {
    .sticky-add-to-cart__bar {
      bottom: 0;
      width: 100%;
      max-width: none;
      border-radius: 0;

      &::before {
        --border: 1px;
      }
    }

    .sticky-add-to-cart__bar .add-to-cart-text__content {
      display: none;
    }

    .sticky-add-to-cart__info[data-has-image='false'] {
      padding-left: 0;
    }

    .sticky-add-to-cart__title {
      font-size: var(--font-paragraph--size);
    }

    .sticky-add-to-cart__button {
      padding: var(--padding-lg);
    }

    .sticky-add-to-cart__price {
      font-size: var(--font-paragraph-small--size);
    }

    .sticky-add-to-cart__button {
      width: var(--height-buy-buttons);
    }

    sticky-add-to-cart:not([data-variant-available='true']) .add-to-cart-text__content {
      display: initial;
    }

    sticky-add-to-cart:not([data-variant-available='true']) .sticky-add-to-cart__button {
      width: auto;
    }
  }

  /* Small mobile - hide text content and compare price */
  @media screen and (max-width: 389px) {
    .sticky-add-to-cart__bar {
      .compare-at-price {
        display: none;
      }
    }

    .sticky-add-to-cart__title {
      display: none;
    }

    /* For product with only default variant show title */
    .sticky-add-to-cart__info[data-singleton='true'] .sticky-add-to-cart__title {
      display: block;
    }

    /* For single variant show title and variant, truncate both. variant should be identifiable with truncation */
    .sticky-add-to-cart__info[data-single-option='true'] .sticky-add-to-cart__title {
      display: block;
    }

    .sticky-add-to-cart__info[data-single-option='true'] .sticky-add-to-cart__variant {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_information",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "content-center-aligned",
          "label": "t:options.page"
        },
        {
          "value": "content-full-width",
          "label": "t:options.full"
        }
      ],
      "default": "content-center-aligned"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "equal_columns",
      "label": "t:settings.equal_columns",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "limit_details_width",
      "label": "t:settings.limit_product_details_width",
      "default": false,
      "visible_if": "{{ section.settings.equal_columns }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "color",
      "id": "gallery_background",
      "label": "Gallery background",
      "default": "#f0eeee"
    },
    {
      "type": "range",
      "id": "gallery_border_radius",
      "label": "Gallery corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_add_to_cart",
      "label": "t:settings.enable_sticky_add_to_cart",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": []
}
{% endschema %}
