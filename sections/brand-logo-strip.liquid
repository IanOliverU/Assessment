<div
  class="brand-logo-strip"
  style="
    --brand-strip-background: {{ section.settings.background_color }};
    --brand-strip-color: {{ section.settings.logo_color }};
    --brand-strip-logo-height: {{ section.settings.logo_max_height }}px;
    --brand-strip-padding-desktop: {{ section.settings.padding_desktop }}px;
    --brand-strip-padding-mobile: {{ section.settings.padding_mobile }}px;
    --brand-strip-gap: {{ section.settings.gap }}px;
  "
>
  <div class="brand-logo-strip__inner brand-logo-strip__inner--{{ section.settings.mobile_layout }}">
    {% for block in section.blocks %}
      {% capture brand_content %}
        {% if block.settings.logo != blank %}
          {{
            block.settings.logo
            | image_url: width: 600
            | image_tag:
              loading: 'lazy',
              widths: '120, 180, 240, 360, 480, 600',
              class: 'brand-logo-strip__image',
              alt: block.settings.text
          }}
        {% else %}
          <span class="brand-logo-strip__text">{{ block.settings.text | escape }}</span>
        {% endif %}
      {% endcapture %}

      {% if block.settings.link != blank %}
        <a class="brand-logo-strip__item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          {{ brand_content }}
        </a>
      {% else %}
        <div class="brand-logo-strip__item" {{ block.shopify_attributes }}>
          {{ brand_content }}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

{% stylesheet %}
  .brand-logo-strip {
    width: 100%;
    background-color: var(--brand-strip-background);
    color: var(--brand-strip-color);
  }

  .brand-logo-strip__inner {
    width: min(100% - 64px, 1120px);
    min-height: 96px;
    margin-inline: auto;
    padding-block: var(--brand-strip-padding-desktop);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--brand-strip-gap);
  }

  .brand-logo-strip__item {
    min-width: 0;
    flex-shrink: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    text-decoration: none;
  }

  .brand-logo-strip__image {
    display: block;
    width: auto;
    height: auto;
    max-width: min(190px, 100%);
    max-height: var(--brand-strip-logo-height);
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .brand-logo-strip__text {
    white-space: nowrap;
    font-family: var(--font-heading--family);
    font-size: clamp(1.45rem, 2.4vw, 2.25rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  @media screen and (max-width: 749px) {
    .brand-logo-strip__inner {
      width: 100%;
      min-height: 0;
      padding: var(--brand-strip-padding-mobile) 16px;
      justify-content: center;
      gap: max(14px, calc(var(--brand-strip-gap) * 0.55)) max(18px, calc(var(--brand-strip-gap) * 0.7));
    }

    .brand-logo-strip__inner--wrap {
      flex-wrap: wrap;
    }

    .brand-logo-strip__inner--scroll {
      justify-content: flex-start;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .brand-logo-strip__inner--scroll::-webkit-scrollbar {
      display: none;
    }

    .brand-logo-strip__inner--scroll .brand-logo-strip__item {
      flex: 0 0 auto;
    }

    .brand-logo-strip__image {
      max-width: 135px;
      max-height: min(var(--brand-strip-logo-height), 30px);
    }

    .brand-logo-strip__text {
      font-size: clamp(1.25rem, 6.4vw, 1.75rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand logo strip",
  "class": "section-brand-logo-strip",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "logo_color",
      "label": "Logo/text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "label": "Logo maximum height",
      "min": 16,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "label": "Desktop vertical padding",
      "min": 8,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Mobile vertical padding",
      "min": 8,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 52
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "wrap",
          "label": "Wrap"
        },
        {
          "value": "scroll",
          "label": "Horizontal scroll"
        }
      ],
      "default": "wrap"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Fallback brand text",
          "default": "BRAND"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Brand logo strip",
      "category": "Custom",
      "blocks": [
        {
          "type": "brand",
          "settings": {
            "text": "VERSACE"
          }
        },
        {
          "type": "brand",
          "settings": {
            "text": "ZARA"
          }
        },
        {
          "type": "brand",
          "settings": {
            "text": "GUCCI"
          }
        },
        {
          "type": "brand",
          "settings": {
            "text": "PRADA"
          }
        },
        {
          "type": "brand",
          "settings": {
            "text": "Calvin Klein"
          }
        }
      ]
    }
  ]
}
{% endschema %}
