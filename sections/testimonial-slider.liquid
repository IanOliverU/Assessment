{% liquid
  assign section_settings = section.settings
  assign section_heading = section_settings.heading
  assign section_heading_id = 'CustomTestimonialsSliderHeading-' | append: section.id
  assign cards_visible_desktop = section_settings.cards_visible_desktop | default: 3
  assign desktop_gap_count = cards_visible_desktop | minus: 1
  assign desktop_gap_total = section_settings.card_gap | times: desktop_gap_count
%}

{% style %}
  #shopify-section-{{ section.id }} {
    --custom-testimonials-container-width: {{ section_settings.container_max_width }}px;
    --custom-testimonials-padding-top: {{ section_settings.padding_top }}px;
    --custom-testimonials-padding-bottom: {{ section_settings.padding_bottom }}px;
    --custom-testimonials-gap: {{ section_settings.card_gap }}px;
    --custom-testimonials-background: {{ section_settings.background_color }};
    --custom-testimonials-card-background: {{ section_settings.card_background_color }};
    --custom-testimonials-border-color: {{ section_settings.border_color }};
    --custom-testimonials-text-color: {{ section_settings.text_color }};
    --custom-testimonials-muted-color: {{ section_settings.muted_text_color }};
    --custom-testimonials-star-color: {{ section_settings.star_color }};
    --custom-testimonials-verified-color: {{ section_settings.verified_icon_color }};
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider {
    overflow: hidden;
    background: var(--custom-testimonials-background);
    color: var(--custom-testimonials-text-color);
    padding-block: var(--custom-testimonials-padding-top) var(--custom-testimonials-padding-bottom);
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__inner {
    max-width: var(--custom-testimonials-container-width);
    margin-inline: auto;
    padding-inline: var(--page-margin, 20px);
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__heading {
    max-width: 9.5ch;
    margin: 0;
    color: var(--custom-testimonials-text-color);
    font-family: var(--font-h1--family, var(--font-heading--family));
    font-style: var(--font-h1--style, normal);
    font-weight: var(--font-h1--weight, 700);
    font-size: clamp(32px, 8.8vw, 48px);
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__controls {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 12px;
    padding-block-end: 3px;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--custom-testimonials-text-color);
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__button:hover {
    background: rgb(0 0 0 / 0.045);
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__button:focus-visible,
  #shopify-section-{{ section.id }} .custom-testimonials-slider__card:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__button svg {
    display: block;
    width: 24px;
    height: 24px;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__viewport {
    margin-block-start: 24px;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__track {
    display: flex;
    gap: var(--custom-testimonials-gap);
    margin: 0;
    padding: 0 1px 4px;
    overflow-x: hidden;
    overflow-y: visible;
    list-style: none;
    scrollbar-width: none;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider--swipe .custom-testimonials-slider__track {
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__track::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__item {
    flex: 0 0 calc(100% - 1px);
    min-width: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__card {
    display: flex;
    flex-direction: column;
    min-height: 186px;
    height: 100%;
    padding: 24px;
    border: 1px solid var(--custom-testimonials-border-color);
    border-radius: 16px;
    background: var(--custom-testimonials-card-background);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.025);
    color: var(--custom-testimonials-text-color);
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__stars {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: rgb(0 0 0 / 0.18);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__star {
    display: inline-flex;
    width: 18px;
    height: 18px;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__star--active {
    color: var(--custom-testimonials-star-color);
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__star svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__customer {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-block-start: 14px;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__avatar,
  #shopify-section-{{ section.id }} .custom-testimonials-slider__avatar-placeholder {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border-radius: 50%;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__avatar {
    display: block;
    object-fit: cover;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__avatar-placeholder {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgb(0 0 0 / 0.055);
    color: var(--custom-testimonials-muted-color);
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__customer-text {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__name-row {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__name {
    overflow-wrap: anywhere;
    color: var(--custom-testimonials-text-color);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.25;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__verified {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--custom-testimonials-verified-color);
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__verified svg {
    display: block;
    width: 12px;
    height: 12px;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__label {
    margin-block-start: 2px;
    color: var(--custom-testimonials-muted-color);
    font-size: 13px;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__review {
    margin: 12px 0 0;
    color: var(--custom-testimonials-muted-color);
    font-size: 14px;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .custom-testimonials-slider__empty {
    margin: 24px 0 0;
    padding: 24px;
    border: 1px dashed var(--custom-testimonials-border-color);
    border-radius: 16px;
    color: var(--custom-testimonials-muted-color);
    font-size: 14px;
    line-height: 1.5;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .custom-testimonials-slider__heading {
      max-width: none;
      font-size: clamp(40px, 4vw, 48px);
    }

    #shopify-section-{{ section.id }} .custom-testimonials-slider__button {
      width: 42px;
      height: 42px;
    }

    #shopify-section-{{ section.id }} .custom-testimonials-slider__viewport {
      margin-block-start: 34px;
    }

    #shopify-section-{{ section.id }} .custom-testimonials-slider__item {
      flex-basis: calc((100% - {{ desktop_gap_total }}px) / {{ cards_visible_desktop }});
      scroll-snap-stop: normal;
    }

    #shopify-section-{{ section.id }} .custom-testimonials-slider__card {
      min-height: 218px;
      padding: 28px 30px;
    }

    #shopify-section-{{ section.id }} .custom-testimonials-slider__review {
      font-size: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .custom-testimonials-slider__track {
      scroll-behavior: auto;
    }
  }
{% endstyle %}

<section
  class="custom-testimonials-slider{% if section_settings.enable_horizontal_scroll %} custom-testimonials-slider--swipe{% endif %}"
  {% if section_heading != blank %}
    aria-labelledby="{{ section_heading_id }}"
  {% else %}
    aria-label="Customer testimonials"
  {% endif %}
  data-custom-testimonials-slider="{{ section.id }}"
>
  <div class="custom-testimonials-slider__inner">
    <div class="custom-testimonials-slider__header">
      {% if section_heading != blank %}
        <h2 class="custom-testimonials-slider__heading" id="{{ section_heading_id }}">
          {{ section_heading | escape }}
        </h2>
      {% endif %}

      {% if section_settings.show_navigation_arrows and section.blocks.size > 0 %}
        <div class="custom-testimonials-slider__controls">
          <button
            type="button"
            class="custom-testimonials-slider__button"
            aria-label="Previous testimonial"
            data-testimonials-prev
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M15.5 4.5 8 12l7.5 7.5-1.4 1.4L5.2 12l8.9-8.9 1.4 1.4Z" fill="currentColor"/>
            </svg>
          </button>
          <button
            type="button"
            class="custom-testimonials-slider__button"
            aria-label="Next testimonial"
            data-testimonials-next
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="m8.5 19.5 7.5-7.5-7.5-7.5 1.4-1.4 8.9 8.9-8.9 8.9-1.4-1.4Z" fill="currentColor"/>
            </svg>
          </button>
        </div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="custom-testimonials-slider__viewport">
        <ul class="custom-testimonials-slider__track" data-testimonials-track>
          {% for block in section.blocks %}
            {% liquid
              assign customer_name = block.settings.customer_name | default: 'Customer'
              assign customer_initial = customer_name | slice: 0, 1
              assign review_text = block.settings.review_text
              assign rating = block.settings.star_rating | times: 1
              assign customer_image = block.settings.customer_image
              assign customer_label = block.settings.customer_label
              assign show_verified = false

              if section_settings.show_verified_badge and block.settings.verified_customer
                assign show_verified = true
              endif
            %}

            <li
              class="custom-testimonials-slider__item"
              {{ block.shopify_attributes }}
            >
              <article
                class="custom-testimonials-slider__card"
                tabindex="0"
                aria-label="{{ customer_name | escape }} testimonial, {{ rating }} out of 5 stars"
              >
                <div class="custom-testimonials-slider__stars" aria-hidden="true">
                  {% for star_index in (1..5) %}
                    <span class="custom-testimonials-slider__star{% if star_index <= rating %} custom-testimonials-slider__star--active{% endif %}">
                      <svg viewBox="0 0 20 20" focusable="false">
                        <path d="m10 1.5 2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 14.8l-5.2 2.7 1-5.8-4.2-4.1 5.8-.8L10 1.5Z"/>
                      </svg>
                    </span>
                  {% endfor %}
                </div>

                <div class="custom-testimonials-slider__customer">
                  {% if customer_image != blank %}
                    {{
                      customer_image
                      | image_url: width: 96
                      | image_tag:
                        width: 48,
                        height: 48,
                        widths: '48, 72, 96',
                        sizes: '40px',
                        alt: customer_name,
                        class: 'custom-testimonials-slider__avatar',
                        loading: 'lazy'
                    }}
                  {% else %}
                    <span class="custom-testimonials-slider__avatar-placeholder" aria-hidden="true">
                      {{ customer_initial | escape }}
                    </span>
                  {% endif %}

                  <div class="custom-testimonials-slider__customer-text">
                    <div class="custom-testimonials-slider__name-row">
                      <span class="custom-testimonials-slider__name">{{ customer_name | escape }}</span>

                      {% if show_verified %}
                        <span class="custom-testimonials-slider__verified" aria-label="Verified customer">
                          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                            <path d="M6.4 11.6 2.9 8.1l1.3-1.3 2.2 2.2 5.4-5.4 1.3 1.3-6.7 6.7Z" fill="currentColor"/>
                          </svg>
                        </span>
                      {% endif %}
                    </div>

                    {% if customer_label != blank %}
                      <div class="custom-testimonials-slider__label">{{ customer_label | escape }}</div>
                    {% endif %}
                  </div>
                </div>

                {% if review_text != blank %}
                  <p class="custom-testimonials-slider__review">{{ review_text | escape }}</p>
                {% endif %}
              </article>
            </li>
          {% endfor %}
        </ul>
      </div>
    {% else %}
      <div class="custom-testimonials-slider__empty">
        Add testimonial blocks to show customer reviews in this section.
      </div>
    {% endif %}
  </div>
</section>

<script>
  (() => {
    const section = document.querySelector('[data-custom-testimonials-slider="{{ section.id }}"]');

    if (!section) return;
    if (section.dataset.testimonialsSliderInit === 'true') return;

    section.dataset.testimonialsSliderInit = 'true';

    const track = section.querySelector('[data-testimonials-track]');
    const previousButton = section.querySelector('[data-testimonials-prev]');
    const nextButton = section.querySelector('[data-testimonials-next]');

    if (!track || (!previousButton && !nextButton)) return;

    const getScrollAmount = () => {
      const card = track.querySelector('.custom-testimonials-slider__item');
      const styles = window.getComputedStyle(track);
      const gap = parseFloat(styles.columnGap || styles.gap) || 0;

      return card ? card.getBoundingClientRect().width + gap : track.clientWidth;
    };

    previousButton?.addEventListener('click', () => {
      track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
    });

    nextButton?.addEventListener('click', () => {
      track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
    });
  })();
</script>

{% schema %}
{
  "name": "Testimonials slider",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "OUR HAPPY CUSTOMERS"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "label": "Container max width",
      "min": 960,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1240
    },
    {
      "type": "range",
      "id": "cards_visible_desktop",
      "label": "Cards visible desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Section padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Section padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Card background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#E6E6E6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#FFC633"
    },
    {
      "type": "color",
      "id": "verified_icon_color",
      "label": "Verified icon color",
      "default": "#01AB31"
    },
    {
      "type": "header",
      "content": "Display"
    },
    {
      "type": "checkbox",
      "id": "show_navigation_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_horizontal_scroll",
      "label": "Enable horizontal scroll/swipe",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_verified_badge",
      "label": "Show verified badge",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "customer_name",
          "label": "Customer name",
          "default": "Sarah M."
        },
        {
          "type": "checkbox",
          "id": "verified_customer",
          "label": "Verified customer",
          "default": true
        },
        {
          "type": "range",
          "id": "star_rating",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review text",
          "default": "The fit is exactly what I wanted and the fabric feels premium without being heavy. I have already worn it twice this week."
        },
        {
          "type": "image_picker",
          "id": "customer_image",
          "label": "Customer image/avatar"
        },
        {
          "type": "text",
          "id": "customer_label",
          "label": "Location or short label",
          "default": "Verified buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials slider",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "customer_name": "Sarah M.",
            "verified_customer": true,
            "star_rating": 5,
            "review_text": "The quality surprised me in the best way. The shirt holds its shape after washing and looks easy to dress up or down.",
            "customer_label": "Verified buyer"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "customer_name": "Alex K.",
            "verified_customer": true,
            "star_rating": 5,
            "review_text": "I ordered a full outfit and every piece felt true to size. Shipping was quick, and the styling is exactly like the photos.",
            "customer_label": "Los Angeles, CA"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "customer_name": "James L.",
            "verified_customer": true,
            "star_rating": 5,
            "review_text": "Clean design, comfortable fit, and the fabric has a really nice weight. This has become my go-to weekend look.",
            "customer_label": "Repeat customer"
          }
        }
      ]
    }
  ]
}
{% endschema %}
