
{% render 'button', link: block.settings.link, additional_class: 'fashion-button-block' %}

{% stylesheet %}
  a.button.fashion-button-block:not(.button-secondary, .button-unstyled) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 48px;
    border: 0;
    border-radius: 999px;
    appearance: none;
    background: #000;
    color: #fff;
    box-shadow: none;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    transition: background-color 180ms ease, opacity 180ms ease;
  }

  a.button.fashion-button-block:not(.button-secondary, .button-unstyled):hover {
    background: #141414;
    color: #fff;
    transform: none;
  }

  a.button.fashion-button-block:not(.button-secondary, .button-unstyled):focus-visible {
    outline: 2px solid #000;
    outline-offset: 4px;
  }

  @media screen and (max-width: 749px) {
    a.button.fashion-button-block:not(.button-secondary, .button-unstyled) {
      width: var(--size-style-width-mobile, 100%);
      min-width: var(--size-style-width-mobile-min, 100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a.button.fashion-button-block:not(.button-secondary, .button-unstyled) {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "t:text_defaults.button_label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_new_tab",
      "default": false
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button",
          "label": "t:options.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.secondary"
        },
        {
          "value": "link",
          "label": "t:options.link"
        }
      ],
      "default": "button"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == \"custom\" }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == \"custom\" }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.button",
      "category": "t:categories.basic",
      "settings": {
        "link": "shopify://collections/all"
      }
    }
  ]
}
{% endschema %}
