<div
  class="hero-stats-block"
  {{ block.shopify_attributes }}
>
  <div class="hero-stats-block__list" role="list">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .hero-stats-block {
    width: min(100%, 640px);
    margin-block-start: clamp(20px, 3vw, 36px);
  }

  .hero-stats-block__list {
    display: flex;
    align-items: stretch;
    width: fit-content;
    max-width: 100%;
  }

  .hero-stat-item {
    min-width: 0;
    padding-inline: clamp(20px, 2.4vw, 32px);
  }

  .hero-stat-item:first-child {
    padding-inline-start: 0;
  }

  .hero-stat-item + .hero-stat-item {
    border-inline-start: 1px solid rgb(0 0 0 / 0.12);
  }

  .hero-stat-item__value {
    margin: 0;
    color: #000;
    font-family: var(--font-body--family);
    font-size: clamp(28px, 2.4vw, 40px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    white-space: nowrap;
  }

  .hero-stat-item__label {
    margin: 5px 0 0;
    color: rgb(0 0 0 / 0.6);
    font-family: var(--font-body--family);
    font-size: clamp(12px, 0.95vw, 14px);
    line-height: 1.4;
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .hero-stats-block {
      margin-block-start: 24px;
    }

    .hero-stats-block__list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      justify-content: center;
      width: 100%;
    }

    .hero-stat-item {
      padding-inline: clamp(12px, 5vw, 28px);
      text-align: center;
    }

    .hero-stat-item:first-child {
      padding-inline-start: clamp(12px, 5vw, 28px);
    }

    .hero-stat-item:nth-child(odd) {
      border-inline-start: 0;
    }

    .hero-stat-item:nth-child(odd):last-child {
      grid-column: 1 / -1;
      margin-block-start: 20px;
    }

    .hero-stat-item__value {
      font-size: clamp(24px, 7.2vw, 30px);
    }

    .hero-stat-item__label {
      font-size: 12px;
      white-space: normal;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero stats",
  "tag": null,
  "blocks": [
    {
      "type": "stat-item"
    }
  ],
  "presets": [
    {
      "name": "Hero stats",
      "category": "Basic",
      "blocks": {
        "stat_1": {
          "type": "stat-item",
          "settings": {
            "value": "200+",
            "label": "International Brands"
          }
        },
        "stat_2": {
          "type": "stat-item",
          "settings": {
            "value": "2,000+",
            "label": "High-Quality Products"
          }
        },
        "stat_3": {
          "type": "stat-item",
          "settings": {
            "value": "30,000+",
            "label": "Happy Customers"
          }
        }
      },
      "block_order": ["stat_1", "stat_2", "stat_3"]
    }
  ]
}
{% endschema %}
